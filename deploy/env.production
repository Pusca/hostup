APP_NAME=HostUp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hostup.it
APP_LOCALE=it
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=NOME_DB
DB_USERNAME=UTENTE_DB
DB_PASSWORD=PASSWORD_DB

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@hostup.it"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (chiavi LIVE o TEST). Vuoto = modalità demo, nessun addebito reale.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
